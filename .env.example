# Copy to .env.local (never commit that file) and fill in.
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives enquiries (comma-separate several)
ENQUIRY_TO=
# Optional: a sender on a domain you verified in Resend. Without it, Resend's test sender is used,
# which can only deliver to the email address of your own Resend account.
ENQUIRY_FROM=
